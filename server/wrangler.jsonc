{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apple-design-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Downloads Apple's guidelines into src/pack/hig.js the first time. `npm run pack` refreshes them.
  "build": { "command": "node scripts/build-hig-pack.mjs --if-missing" },
  // One SVG per SF Symbol, written by the extractor on a Mac. Served at /symbols/NAME.svg and read by the symbol tools.
  "assets": { "directory": "./assets", "binding": "ASSETS" },
  "observability": { "enabled": true }
}
