{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apple-design-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Before every deploy (and `wrangler dev`): Apple's guidelines are downloaded into src/pack/hig.js the
  // first time (`npm run pack` refreshes them), then `npm run check` stops when assets/ lacks the files
  // the packs describe (a deploy replaces every live file), or when the types, the SVG tests or the
  // ranking tests fail.
  "build": { "command": "node scripts/build-hig-pack.mjs --if-missing && npm run check" },
  // One SVG per SF Symbol, written by the extractor on a Mac. Served at /symbols/NAME.svg and read by the symbol tools.
  // assets/ also holds the website: index.html at / and privacy.html at /privacy. Static files are served
  // before the Worker runs, so never add a file or folder named "mcp" there: it would shadow the server at /mcp.
  "assets": { "directory": "./assets", "binding": "ASSETS" },
  // The site and the server on apple-design-mcp.com; the workers.dev address stays on as a backup.
  "routes": [{ "pattern": "apple-design-mcp.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
