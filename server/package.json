{
  "name": "apple-design-mcp-server",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "pack": "node scripts/build-hig-pack.mjs",
    "pack:devices": "node scripts/build-device-pack.mjs",
    "pack:safe-areas": "node scripts/merge-safe-areas.mjs",
    "pack:symbol-index": "node scripts/build-symbol-index.mjs",
    "pack:technologies": "node scripts/build-technology-pack.mjs",
    "pack:values": "node scripts/build-design-values.mjs",
    "pack:ui-kit": "node scripts/build-ui-kit-pack.mjs",
    "pack:bezels": "node scripts/build-bezel-pack.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-assets.mjs && tsc --noEmit && node test/svg.mjs && node test/ranking.mjs && node test/coverage.mjs",
    "test": "node test/smoke.mjs",
    "test:svg": "node test/svg.mjs",
    "test:ranking": "node test/ranking.mjs",
    "test:coverage": "node test/coverage.mjs",
    "export:ui-kit-svg": "node scripts/export-ui-kit-svg.mjs",
    "redraw:ui-kit-svg": "node scripts/redraw-flattened.mjs",
    "gallery": "node scripts/build-ui-kit-gallery.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  }
}
